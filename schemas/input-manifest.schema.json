{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fitplate.invalid/schemas/input-manifest.schema.json",
  "title": "FitPlate InputManifest",
  "description": "What the program froze for one task revision, and the exact facts it froze it from: the request revision and hash, the draft hash, the confirmation receipt binding, and the compiler identity. The confirmation receipt is produced by the trusted Host adapter from a real native approval record and handed to the intake core; the core verifies the binding (draft hash, request revision, attachment bytes hash, session scope) and does NOT prove the native approval itself - it never reads a confirmed flag from the request, model fields or a free-form string. Hash and version fields are generated by the program.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "task_id",
    "task_revision",
    "request_id",
    "request_revision",
    "request_sha256",
    "draft_hash",
    "confirmation",
    "compiler",
    "hashes",
    "created_at",
    "device_card",
    "stage",
    "source_map"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^manifest-[a-z0-9][a-z0-9-]{1,40}-r[0-9]{1,5}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
    },
    "task_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
    },
    "request_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "draft_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_kind",
        "receipt_id",
        "draft_hash",
        "request_id",
        "request_revision",
        "attachment_sha256",
        "session_scope",
        "approved_at"
      ],
      "properties": {
        "receipt_kind": {
          "const": "fitplate-confirmation-receipt",
          "description": "Only this receipt shape is accepted; arbitrary confirmation strings are refused."
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^conf-[a-z0-9][a-z0-9-]{1,62}$"
        },
        "draft_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
        },
        "request_revision": {
          "type": "integer",
          "minimum": 1
        },
        "attachment_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the exact attachment bytes the user confirmed; the caller must supply the same bytes hash independently, so a receipt cannot be replayed onto other content."
        },
        "session_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "approved_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_content_sha256",
        "scene_content_sha256",
        "task_file_sha256",
        "scene_file_sha256"
      ],
      "properties": {
        "task_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scene_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "task_file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "scene_file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "design_file_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "device_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "description": "The registered card this revision was compiled against, by id and content hash - a card edited after the draft can never be frozen under the old draft."
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "request_revision",
        "request_sha256",
        "draft_hash",
        "attachment_sha256",
        "session_scope",
        "staged_at"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,40}$"
        },
        "request_revision": {
          "type": "integer",
          "minimum": 1
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "draft_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "attachment_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "session_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "staged_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "description": "The staged request facts the commit matched: a newer request revision staged (even NEEDS_INPUT, even unpublished) invalidates old drafts."
    },
    "source_map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plate",
        "base_holes",
        "device_interface",
        "environment",
        "requirements"
      ],
      "properties": {
        "plate": {
          "enum": [
            "user_supplied",
            "measured_device",
            "vendor_datasheet",
            "synthetic_teaching_fixture",
            "design_assumption"
          ]
        },
        "base_holes": {
          "enum": [
            "user_supplied",
            "measured_device",
            "vendor_datasheet",
            "synthetic_teaching_fixture",
            "design_assumption"
          ]
        },
        "device_interface": {
          "enum": [
            "user_supplied",
            "measured_device",
            "vendor_datasheet",
            "synthetic_teaching_fixture",
            "design_assumption"
          ]
        },
        "environment": {
          "enum": [
            "user_supplied",
            "measured_device",
            "vendor_datasheet",
            "synthetic_teaching_fixture",
            "design_assumption"
          ]
        },
        "requirements": {
          "enum": [
            "user_supplied",
            "measured_device",
            "vendor_datasheet",
            "synthetic_teaching_fixture",
            "design_assumption"
          ]
        }
      },
      "description": "Where each area's numbers come from. The device interface is the only vendor area in this path; a geometry PASS never upgrades a source level."
    },
    "intake_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "device_card",
        "draft",
        "text_proposals"
      ],
      "properties": {
        "request": {
          "type": "object",
          "description": "The exact request object this revision was compiled from (verified by the real request schema and the manifest's request_sha256)."
        },
        "device_card": {
          "type": "object",
          "description": "The registered device card object (verified by the manifest's device_card.sha256)."
        },
        "draft": {
          "type": "object",
          "description": "The full verified ConstraintDraft (verified by the manifest's draft_hash and a deterministic recompilation)."
        },
        "text_proposals": {
          "type": "array",
          "maxItems": 4,
          "description": "The canonical ORIGINAL model assertion shape (field_path/kind/quote/value/unit), never the program text_interpretations fact - re-verified against the real request text, never trusted as a program value.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field_path", "kind", "quote", "value", "unit"],
            "properties": {
              "field_path": { "const": "plate.width" },
              "kind": { "const": "upper_bound" },
              "quote": {
                "type": "object",
                "additionalProperties": false,
                "required": ["start", "end", "literal"],
                "properties": {
                  "start": { "type": "integer", "minimum": 0 },
                  "end": { "type": "integer", "minimum": 1 },
                  "literal": { "type": "string", "minLength": 1, "maxLength": 8192 }
                }
              },
              "value": { "type": "number" },
              "unit": { "enum": ["mm", "cm", "m", "um", "in"] }
            }
          }
        }
      },
      "description": "Optional and additive: present only when the revision was published with verified text proposals. It carries the original request, card, full draft and the canonical original proposals so the frozen inputs are reproducible without any side file; the manifest's own hashes (request_sha256, device_card.sha256, draft_hash) bind it, so tampering the evidence bytes breaks the index SHA. Omitted entirely for a no-proposal revision, whose old bytes and hashes are unchanged."
    }
  }
}
